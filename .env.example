# OFD (Of the Day) configuration. Copy to .env and fill in what you use.
# Nothing in this file is required: with no credentials OFD still reads a folder that is
# shared "with anyone with the link" (public mode) and the PDF upload fallback always works.

# Drive folder that holds Morning-Briefing-YYYY-MM-DD.pdf files
DRIVE_FOLDER_ID=1RpOr2HsXSGuFpeSaVzYJssvmxzY0HhNG

# Auth mode: auto | public | api_key | service_account | oauth
# auto picks the first configured option in this order: service_account, oauth, api_key, public
DRIVE_AUTH=auto

# Option A: Google API key (free; enough when the folder is shared with "anyone with the link")
GOOGLE_API_KEY=

# Option B: service account (share the folder with the service account's e-mail as Viewer)
# Either the JSON key inline, or a path to the JSON key file. Never commit the key.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Option C: OAuth desktop app with a stored refresh token (run `npm run drive:auth` to get one)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Server
PORT=8787
OFD_CACHE_DIR=.cache
# Set to 0 to disable the OCR fallback for scanned PDFs
OFD_OCR=1
